generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HOUSEHOLD
  COLLECTOR
  RAGPICKER
  KABADIWALA
  RECYCLER
  ADMIN
}

enum MaterialType {
  PET_PLASTIC
  HDPE_PLASTIC
  MIXED_PLASTIC
  PAPER
  CARDBOARD
  METAL_FERROUS
  METAL_NON_FERROUS
  GLASS
  E_WASTE
  ORGANIC
  MIXED
}

enum BatchStatus {
  CREATED
  COLLECTED
  IN_TRANSIT
  AT_AGGREGATOR
  GRADED
  DISPATCHED
  RECEIVED_BY_RECYCLER
  RECYCLED
}

enum CustodyEventType {
  CREATED
  PICKUP
  HANDOFF
  WEIGHT_UPDATE
  QUALITY_GRADED
  DISPATCHED
  RECEIVED
  RECYCLED
  LOCATION_UPDATE
}

enum QualityGrade {
  A
  B
  C
  CONTAMINATED
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

model User {
  id              String   @id @default(cuid())
  phone           String   @unique
  name            String
  pinHash         String
  role            UserRole
  langPref        String   @default("en")
  address         String?
  gpsLat          Float?
  gpsLng          Float?
  walletBalance   Float    @default(0)
  reputationScore Float    @default(5.0)
  isActive        Boolean  @default(true)
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batchesCreated    WasteBatch[]   @relation("CreatedBy")
  batchesCustodied  WasteBatch[]   @relation("CurrentCustodian")
  custodyFrom       CustodyEvent[] @relation("CustodyFrom")
  custodyTo         CustodyEvent[] @relation("CustodyTo")
  payments          Payment[]      @relation("PaymentFrom")
  paymentsReceived  Payment[]      @relation("PaymentTo")
  demandPosts       DemandPost[]
  routes            Route[]

  @@index([role])
  @@index([phone])
}

model WasteBatch {
  id               String       @id @default(cuid())
  shortcode        String       @unique
  qrPayload        String
  materialType     MaterialType
  status           BatchStatus  @default(CREATED)
  weightKg         Float
  contaminationPct Float        @default(0)
  qualityGrade     QualityGrade?
  description      String?
  photoUrl         String?

  originUserId        String
  currentCustodianId  String

  origin          User @relation("CreatedBy", fields: [originUserId], references: [id])
  currentCustodian User @relation("CurrentCustodian", fields: [currentCustodianId], references: [id])

  custodyEvents   CustodyEvent[]
  payments        Payment[]
  impactRecord    ImpactLedger?
  matchedDemand   DemandPost?   @relation(fields: [matchedDemandId], references: [id])
  matchedDemandId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortcode])
  @@index([status])
  @@index([materialType])
  @@index([currentCustodianId])
}

model CustodyEvent {
  id            String           @id @default(cuid())
  batchId       String
  fromUserId    String?
  toUserId      String?
  eventType     CustodyEventType
  gpsLat        Float
  gpsLng        Float
  photoUrl      String?
  voiceMemoUrl  String?
  weightKg      Float?
  qualityGrade  QualityGrade?
  pinSignature  String?
  notes         String?
  prevHash      String
  hash          String
  merkleLeafIdx Int?
  anchorId      String?
  anchor        MerkleAnchor?   @relation(fields: [anchorId], references: [id])

  batch    WasteBatch @relation(fields: [batchId], references: [id])
  fromUser User?      @relation("CustodyFrom", fields: [fromUserId], references: [id])
  toUser   User?      @relation("CustodyTo", fields: [toUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([hash])
  @@index([createdAt])
}

model MerkleAnchor {
  id          String   @id @default(cuid())
  rootHash    String   @unique
  leafCount   Int
  periodStart DateTime
  periodEnd   DateTime
  anchoredAt  DateTime @default(now())
  jobId       String?

  events CustodyEvent[]

  @@index([anchoredAt])
}

model PriceQuote {
  id           String       @id @default(cuid())
  materialType MaterialType
  ratePerKg    Float
  sourceIndex  String       @default("GREVORO_MARKET")
  validFrom    DateTime
  validTo      DateTime
  createdAt    DateTime     @default(now())

  @@index([materialType, validTo])
}

model DemandPost {
  id               String       @id @default(cuid())
  recyclerId       String
  recycler         User         @relation(fields: [recyclerId], references: [id])
  materialType     MaterialType
  minQtyKg         Float
  maxPricePerKg    Float
  locationGeohash  String?
  locationLabel    String?
  qualityRequired  QualityGrade?
  deadline         DateTime
  isActive         Boolean      @default(true)
  fulfilledKg      Float        @default(0)
  batches          WasteBatch[]
  createdAt        DateTime     @default(now())

  @@index([materialType, isActive])
  @@index([recyclerId])
}

model Route {
  id                   String   @id @default(cuid())
  collectorId          String
  collector            User     @relation(fields: [collectorId], references: [id])
  stops                Json
  optimizedDistanceKm  Float
  estimatedDurationMin Float
  status               String   @default("PLANNED")
  scheduledDate        DateTime
  completedAt          DateTime?
  createdAt            DateTime @default(now())

  @@index([collectorId, scheduledDate])
}

model Payment {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  amount     Float
  method     String   @default("DIGITAL_WALLET")
  batchId    String?
  txRef      String   @unique @default(cuid())
  status     String   @default("COMPLETED")
  createdAt  DateTime @default(now())

  from  User        @relation("PaymentFrom", fields: [fromUserId], references: [id])
  to    User        @relation("PaymentTo", fields: [toUserId], references: [id])
  batch WasteBatch? @relation(fields: [batchId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@index([batchId])
}

model ImpactLedger {
  id             String   @id @default(cuid())
  batchId        String   @unique
  batch          WasteBatch @relation(fields: [batchId], references: [id])
  kgDiverted     Float
  co2eSavedKg    Float
  workerPayoutInr Float
  materialType   MaterialType
  recordedAt     DateTime @default(now())

  @@index([recordedAt])
  @@index([materialType])
}

model Job {
  id         String    @id @default(cuid())
  queue      String
  bullJobId  String?
  payload    Json
  status     JobStatus @default(WAITING)
  result     Json?
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([queue, status])
  @@index([createdAt])
}
