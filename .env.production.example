# GREVORO — Production Environment Variables (Option A: Free Tier)
# Copy to .env.production and fill in values from each service.
# See docs/DEPLOY.md for step-by-step provider setup.

# ─── Neon Postgres ─────────────────────────────────────────────────────────────
# https://console.neon.tech → New Project → Connection String
DATABASE_URL=postgresql://USER:PASS@ep-xxx-yyy.ap-southeast-1.aws.neon.tech/grevoro?sslmode=require

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
# https://console.upstash.com → Create Database → Redis TCP URL
REDIS_URL=rediss://default:TOKEN@global-xxx.upstash.io:6379

# ─── MongoDB Atlas M0 ─────────────────────────────────────────────────────────
# https://cloud.mongodb.com → Connect → Drivers → Python 3.6+ format
MONGO_URL=mongodb+srv://grevoro:PASS@cluster0.xxxxx.mongodb.net/grevoro?retryWrites=true&w=majority

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d

# ─── Cloudflare R2 ─────────────────────────────────────────────────────────────
# https://dash.cloudflare.com → R2 → Create bucket 'grevoro-media' → API Tokens
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=grevoro-media
S3_ACCESS_KEY_ID=R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=R2_SECRET_KEY
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxx.r2.dev

# ─── Hugging Face Spaces (ML) ─────────────────────────────────────────────────
# https://huggingface.co/new-space → SDK: Docker → deploy apps/ml
ML_SERVICE_URL=https://YOUR_HF_USERNAME-grevoro-ml.hf.space

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Render: https://dashboard.render.com → Web Service → auto-assigned URL
NEXT_PUBLIC_API_URL=https://grevoro-api.onrender.com
NEXT_PUBLIC_WS_URL=wss://grevoro-api.onrender.com
API_PORT=4000

NODE_ENV=production
APP_NAME=GREVORO
MERKLE_ANCHOR_INTERVAL_MS=600000
MERKLE_ANCHOR_BATCH_SIZE=100
